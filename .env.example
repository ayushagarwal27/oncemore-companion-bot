# --- required ---------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- storage (match docker-compose.yml) -------------------------------------
POSTGRES_DSN=postgresql://companion:companion@localhost:5432/companion
REDIS_URL=redis://localhost:6379/0

# --- models -----------------------------------------------------------------
# Tiers matter more than the exact strings; verify against the live model list.
CHAT_MODEL=gpt-5.6-sol
EXTRACTION_MODEL=gpt-5.6-luna
ADJUDICATOR_MODEL=gpt-5.6-terra
JUDGE_MODEL=gpt-5.6-sol
ORACLE_MODEL=gpt-5.5-pro
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# --- retrieval tuning -------------------------------------------------------
RETRIEVAL_FINAL_K=8
MEMORY_TOKEN_BUDGET=900
W_RRF=0.6
W_IMPORTANCE=0.25
W_STRENGTH=0.15

# --- write path -------------------------------------------------------------
EXTRACTION_AGGRESSIVENESS=balanced
HOT_PATH_IMPORTANCE_THRESHOLD=0.75
